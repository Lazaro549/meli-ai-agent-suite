# Mercado Libre API settings
MELI_BASE_URL=https://api.mercadolibre.com
MELI_ACCESS_TOKEN=
MELI_APP_ID=
MELI_APP_SECRET=
MELI_REDIRECT_URI=http://localhost:8000/callback
MELI_SITE_ID=MLA

# AWS credentials should preferably come from the standard boto3 credential chain
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

APP_ENV=development
LOG_LEVEL=INFO
MAX_TOKENS=1024
TEMPERATURE=0.2
REQUEST_TIMEOUT=15
MAX_RETRIES=2
LOW_STOCK_THRESHOLD=5
